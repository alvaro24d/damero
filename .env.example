# Clave de la API de Claude, necesaria para que se escriban las definiciones.
# Se saca en https://console.anthropic.com -> API keys.
# Copia este fichero a .env.local y pega la tuya.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo que redacta las definiciones.
# Por defecto claude-sonnet-5.
# DAMERO_MODEL=claude-opus-5
